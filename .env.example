# DEV орчны жишээ. `cp .env.example .env` хийгээд нууц утгуудыг солино.
# Бодит нууц утгыг репод commit хийхгүй (INV-10).
HOST_PORT=8080
MOBILE_HOST_PORT=8090
S3_HOST_PORT=8333
MAILPIT_UI_PORT=8025
SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me

# ≥ 32 байт санамсаргүй мөр (PAR-AURA-001): openssl rand -base64 48
AURA_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# S3 (SeaweedFS). Түлхүүр нь deploy/dev/seaweedfs-s3.json-той таарна (PAR-AURA-002).
# PUBLIC_ENDPOINT — presigned URL-ийн хост; утсаар туршихад http://<LAN_IP>:8333
AURA_S3_PUBLIC_ENDPOINT=http://localhost:8333
AURA_S3_REGION=us-east-1
AURA_S3_BUCKET=aura-media
AURA_S3_ACCESS_KEY=aura-dev-access
AURA_S3_SECRET_KEY=aura-dev-secret-change-me

# SMTP — DEV-д Mailpit (PAR-AURA-003)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
AURA_MAIL_FROM=Aura <no-reply@aura.local>

# Web Push (VAPID) — хоосон бол Web Push алгасагдана (PAR-AURA-004)
AURA_VAPID_PUBLIC_KEY=
AURA_VAPID_PRIVATE_KEY=
AURA_VAPID_SUBJECT=

# Google OAuth — хоосон бол Google товч нуугдана (PAR-AURA-005)
AURA_GOOGLE_CLIENT_ID=
AURA_GOOGLE_CLIENT_SECRET=
AURA_OAUTH_REDIRECT_BASE=http://localhost:8080
# E2E-д тестийн IdP (GAP-18): AURA_GOOGLE_ISSUER=http://host.docker.internal:<порт>, AURA_GOOGLE_ID_TOKEN_ALG=HS256
AURA_GOOGLE_ISSUER=https://accounts.google.com
AURA_GOOGLE_ID_TOKEN_ALG=RS256
# Имэйлийн холбоос ба OAuth-ийн вэб буцах хуудасны гаднах хаяг
AURA_WEB_BASE_URL=http://localhost:8090

AURA_ADMIN_EMAILS=
AURA_CORS_ALLOWED_ORIGINS=http://localhost:8090
AURA_COOKIE_SECURE=false
AURA_SENTRY_DSN=

EXPO_PUBLIC_API_URL=http://localhost:8080
