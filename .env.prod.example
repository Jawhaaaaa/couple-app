# PROD орчны жишээ (T-90, AC-162). Сервер дээр: cp .env.prod.example .env.prod && chmod 600 .env.prod
# Доорх бүх утга placeholder — бодит нууц утгыг зөвхөн сервер дээрх .env.prod-д бичнэ (INV-10).
# `.env.prod` нь .gitignore-ийн `.env.*` дүрмээр репод орохгүй.
# Шалгах: docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod.example config -q

# --- Домэйн ба HTTPS (DuckDNS, Caddy) -----------------------------------------
# DuckDNS-ийн дэд домэйн (жишээ нь "aura-example" → aura-example.duckdns.org)
DUCKDNS_SUBDOMAIN=aura-example
# duckdns.org → нэвтэрсний дараа хуудасны дээд хэсэгт байгаа token (UUID)
DUCKDNS_TOKEN=change-me-duckdns-token
AURA_DOMAIN=aura-example.duckdns.org
# Let's Encrypt-ийн мэдэгдэл (гэрчилгээ дуусах г.м.) очих имэйл
ACME_EMAIL=ops@example.com

# --- Өгөгдлийн сан (PostgreSQL 16) --------------------------------------------
POSTGRES_DB=aura
POSTGRES_USER=aura
# openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres-password

# --- Backend ------------------------------------------------------------------
# ≥ 32 байт санамсаргүй мөр (PAR-AURA-001): openssl rand -base64 48
AURA_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# Админ (GET /admin/metrics, PAR-AURA-007) — таслалаар
AURA_ADMIN_EMAILS=admin@example.com
# Хосын медиа квот (PAR-AURA-008), байтаар — 10 GB
AURA_STORAGE_QUOTA_BYTES=10737418240
# Хоосон бол алдаа гадагш илгээгдэхгүй (PAR-AURA-009)
AURA_SENTRY_DSN=
BACKEND_MEM_LIMIT=4g

# --- Медиа (SeaweedFS S3; MinIO ашиглахгүй) -----------------------------------
# Compose эхлэхдээ SeaweedFS-ийн identity-г эдгээрээр үүсгэнэ (PAR-AURA-002)
AURA_S3_BUCKET=aura-media
AURA_S3_REGION=us-east-1
# openssl rand -hex 16 / openssl rand -base64 30
AURA_S3_ACCESS_KEY=change-me-s3-access-key
AURA_S3_SECRET_KEY=change-me-s3-secret-key

# --- Имэйл (SMTP, үнэгүй үйлчилгээ — PAR-AURA-003, GAP-09) ---------------------
# Жишээ: Brevo (smtp-relay.brevo.com:587, өдөрт 300), Gmail app password (smtp.gmail.com:587)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me-smtp-user
SPRING_MAIL_PASSWORD=change-me-smtp-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
AURA_MAIL_FROM=Aura <no-reply@example.com>

# --- Web Push (VAPID, PAR-AURA-004, OPS-AURA-003) -----------------------------
# Deploy үед нэг удаа үүсгэнэ: docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
# Солих нь бүх push subscription-ыг хүчингүй болгоно — сольж болохгүй.
AURA_VAPID_PUBLIC_KEY=change-me-vapid-public-key
AURA_VAPID_PRIVATE_KEY=change-me-vapid-private-key
AURA_VAPID_SUBJECT=mailto:ops@example.com
# Expo push (native APK, GAP-01) — хоосон бол алгасна (PAR-AURA-006)
AURA_EXPO_PUSH_ACCESS_TOKEN=

# --- Google OAuth (PAR-AURA-005) — хоосон бол Google товч нуугдана -------------
# Google Cloud Console → Credentials → OAuth client (Web). Authorized redirect URI:
#   https://<AURA_DOMAIN>/api/v1/auth/oauth/google/callback
AURA_GOOGLE_CLIENT_ID=
AURA_GOOGLE_CLIENT_SECRET=

# --- Гадаад өгөгдөл (PAR-AURA-010) --------------------------------------------
AURA_WEATHER_BASE_URL=https://api.open-meteo.com
AURA_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com

# --- Backup (T-91, docs/BACKUP.md) -------------------------------------------
BACKUP_DIR=/var/backups/aura
BACKUP_RETENTION_DAYS=30
# Медиа ба dump-ийн гадаад хуулбар. Хоосон бол BACKUP_DIR/media хавтас руу (нэг диск — эрсдэлтэй).
# Oracle Object Storage: "oracle:<bucket>" (доорх OCI_* хэрэгтэй)
BACKUP_REMOTE=
# Oracle Object Storage-ийн S3-нийцтэй endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=
# Profile → Customer Secret Keys → Generate
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# --- Сэрэмжлүүлэг (docs/OPERATIONS.md) ---------------------------------------
# Хоосон бол зөвхөн syslog (logger -t aura-alert). Жишээ: https://ntfy.sh/<нууц-сэдэв>
ALERT_WEBHOOK_URL=
